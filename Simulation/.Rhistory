plot.PP(simW); title("Weibull Process")
curve(Weibull_I(x, Beta_val, Theta_val), 0, Tmax_val, col = "red", lwd = 2, main = "Weibull Intensity")
par(mfrow = c(1, 2))
simW <- simulWeibull(Beta_val_dec, Theta_val, Tmax_val)
